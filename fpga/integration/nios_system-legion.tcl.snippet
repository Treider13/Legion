# ============================================================================
# LEGION — добавление в nios_system.tcl (hdl/fpga/platforms/bladerf/build/).
# Паттерн скопирован со штатных PIO (control, iq_corr_*) того же файла.
# Три PIO: legion_wdata (32 out), legion_aws (8 out: bit7=we, 6..0=addr),
#          legion_status (32 in).
# ОБЯЗАТЕЛЬНО:
#  1) блок ставится ДО save_system — иначе PIO не попадают в nios_system.qsys
#     и BSP не получает LEGION_*_BASE (поймано сборкой micro 2026-08-27);
#  2) каждому PIO нужны clock/reset — без них qsys-generate падает;
#  3) адреса — с выравниванием 16 байт (шаг 0x10) и БЕЗ конфликтов:
#     x40/x115: 0x10500/0x10510/0x10520 (свободно);
#     micro A4/A9: 0x9600/0x9610/0x9620 (0x10500+ занято axi_ad9361_0.s_axi,
#     окно 0x10000..0x1ffff).
# ============================================================================

add_instance legion_wdata altera_avalon_pio
set_instance_parameter_value legion_wdata {bitClearingEdgeCapReg} {0}
set_instance_parameter_value legion_wdata {bitModifyingOutReg} {0}
set_instance_parameter_value legion_wdata {captureEdge} {0}
set_instance_parameter_value legion_wdata {direction} {Output}
set_instance_parameter_value legion_wdata {edgeType} {RISING}
set_instance_parameter_value legion_wdata {generateIRQ} {0}
set_instance_parameter_value legion_wdata {irqType} {LEVEL}
set_instance_parameter_value legion_wdata {resetValue} {0.0}
set_instance_parameter_value legion_wdata {simDoTestBenchWiring} {0}
set_instance_parameter_value legion_wdata {simDrivenValue} {0.0}
set_instance_parameter_value legion_wdata {width} {32}

add_instance legion_aws altera_avalon_pio
set_instance_parameter_value legion_aws {bitClearingEdgeCapReg} {0}
set_instance_parameter_value legion_aws {bitModifyingOutReg} {0}
set_instance_parameter_value legion_aws {captureEdge} {0}
set_instance_parameter_value legion_aws {direction} {Output}
set_instance_parameter_value legion_aws {edgeType} {RISING}
set_instance_parameter_value legion_aws {generateIRQ} {0}
set_instance_parameter_value legion_aws {irqType} {LEVEL}
set_instance_parameter_value legion_aws {resetValue} {0.0}
set_instance_parameter_value legion_aws {simDoTestBenchWiring} {0}
set_instance_parameter_value legion_aws {simDrivenValue} {0.0}
set_instance_parameter_value legion_aws {width} {8}

add_instance legion_status altera_avalon_pio
set_instance_parameter_value legion_status {bitClearingEdgeCapReg} {0}
set_instance_parameter_value legion_status {bitModifyingOutReg} {0}
set_instance_parameter_value legion_status {captureEdge} {0}
set_instance_parameter_value legion_status {direction} {Input}
set_instance_parameter_value legion_status {edgeType} {RISING}
set_instance_parameter_value legion_status {generateIRQ} {0}
set_instance_parameter_value legion_status {irqType} {LEVEL}
set_instance_parameter_value legion_status {resetValue} {0.0}
set_instance_parameter_value legion_status {simDoTestBenchWiring} {0}
set_instance_parameter_value legion_status {simDrivenValue} {0.0}
set_instance_parameter_value legion_status {width} {32}

# --- exported interfaces (паттерн: add_interface + EXPORT_OF) ---
add_interface legion_wdata conduit end
set_interface_property legion_wdata EXPORT_OF legion_wdata.external_connection
add_interface legion_aws conduit end
set_interface_property legion_aws EXPORT_OF legion_aws.external_connection
add_interface legion_status conduit end
set_interface_property legion_status EXPORT_OF legion_status.external_connection

# --- clock/reset (обязательно; без них qsys-generate: "must be connected") ---
add_connection system_clock.clk legion_wdata.clk
add_connection system_clock.clk_reset legion_wdata.reset
add_connection system_clock.clk legion_aws.clk
add_connection system_clock.clk_reset legion_aws.reset
add_connection system_clock.clk legion_status.clk
add_connection system_clock.clk_reset legion_status.reset

# --- подключение к шине NIOS (паттерн: add_connection + baseAddress) ---
# Адреса ниже — для x40. Для micro: 0x00009600 / 0x00009610 / 0x00009620.
add_connection nios2.data_master legion_wdata.s1
set_connection_parameter_value nios2.data_master/legion_wdata.s1 arbitrationPriority {1}
set_connection_parameter_value nios2.data_master/legion_wdata.s1 baseAddress {0x00010500}
set_connection_parameter_value nios2.data_master/legion_wdata.s1 defaultConnection {0}

add_connection nios2.data_master legion_aws.s1
set_connection_parameter_value nios2.data_master/legion_aws.s1 arbitrationPriority {1}
set_connection_parameter_value nios2.data_master/legion_aws.s1 baseAddress {0x00010510}
set_connection_parameter_value nios2.data_master/legion_aws.s1 defaultConnection {0}

add_connection nios2.data_master legion_status.s1
set_connection_parameter_value nios2.data_master/legion_status.s1 arbitrationPriority {1}
set_connection_parameter_value nios2.data_master/legion_status.s1 baseAddress {0x00010520}
set_connection_parameter_value nios2.data_master/legion_status.s1 defaultConnection {0}
